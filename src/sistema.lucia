// Archivo: src/sistema.lucia
import "interfaz.lucia";
import "evaluador.lucia";

func ejecutarSistema(): void {
    // 1. Instanciamos tu matriz orientada a objetos
    let hoja = Matriz(); 
    print("Matriz Orientada a Objetos lista en memoria.");
    
    let ejecutable = true;
    let opcion = ""; 

    while (ejecutable) {
        mostrarMenu();
        opcion = input("Elige una opción: "); 
        
        if (opcion == "1") {
            print("\n--- ASIGNAR VALOR ---");
            
            // 2. Aprovechamos tu nueva lógica para pedir la celda directa (ej. A1)
            let coord = input("Ingresa la celda (ej. A1, C4, J10): ");
            let valor = input("Ingresa el valor o fórmula: ");
            
            // 3. Tu clase hace todo el trabajo de guardado y cálculo
            hoja.registrarValorEnCelda(coord, valor);
            
            print("¡Valor procesado correctamente!");
            
        } else if (opcion == "2") {
            // Llamamos a tu método de impresión
            hoja.mostrarMatrizFormulas();
            
        } else if (opcion == "3") {
            // Llamamos a tu método de impresión
            hoja.mostrarMatrizValores();            
            
        } else if (opcion == "4") {
            print("Cerrando la hoja de cálculo...");
            ejecutable = false; 
        } else {
            print("Opción no válida.");
        }
    }
}